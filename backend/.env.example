# ============================================================
# FinControl — Backend: exemplo de variáveis de ambiente
#
# Copie para .env (LOCAL, não versionado) OU exporte no seu shell:
#   Linux/macOS:  source backend/.env.example  (após ajustar) para testes rápidos
#   Windows:      $env:VAR = "valor"  (ou use docker-compose.dev.yml)
#
# Estes valores são para DESENVOLVIMENTO LOCAL apenas.
# Em produção (Render) preencha via painel — NUNCA commitar segredos reais.
# ============================================================

# Perfil ativo: development (local) ou production (Render)
SPRING_PROFILES_ACTIVE=development

# Conexão do MongoDB.
#  - Local (Docker):  mongodb://localhost:27017/fincontrol_dev
#  - Local (instalado): mongodb://localhost:27017/fincontrol_dev
MONGODB_URI=mongodb://localhost:27017/fincontrol_dev

# Segredo do JWT — mínimo 32 caracteres. Em produção use um valor longo e aleatório.
JWT_SECRET=dev-only-chave-jwt-troque-em-producao-123456

# Duração do token (ISO-8601 ou milissegundos)
JWT_EXPIRATION=PT8H

# Origens permitidas no CORS (uma ou várias separadas por vírgula).
# Em dev, libere as portas que o frontend usa.
FRONTEND_URL=http://localhost:5500,http://localhost:3000,http://localhost:5173,http://localhost:8081,http://127.0.0.1:5500

# Assistente com IA (API do Claude). Sem a chave, o chat responde em modo local por regras.
# Crie a chave em https://console.anthropic.com e NUNCA a versione.
ANTHROPIC_API_KEY=
# Opcional: modelo (padrão claude-haiku-5-5, o mais barato) e limite de tokens da resposta.
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_MAX_TOKENS=600

# ------------------------------------------------------------------
# PRODUÇÃO (não use os valores acima) — defina no painel do Render:
#   SPRING_PROFILES_ACTIVE = production
#   MONGODB_URI            = mongodb+srv://USER:PASS@cluster.../fincontrol
#   JWT_SECRET             = (segredo longo e aleatório)
#   JWT_EXPIRATION         = PT1H
#   FRONTEND_URL           = https://SEU-FRONTEND.vercel.app
# ------------------------------------------------------------------